# 把这个文件复制成 .env，然后填入你自己的 API key。
# 千万不要把真正的 .env 文件提交到 GitHub。

# DeepSeek API key。
# 去 https://platform.deepseek.com/ 创建后，填到这里。
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# DeepSeek 官方 OpenAI-compatible base_url。
OPENAI_BASE_URL=https://api.deepseek.com

# 入门阶段建议先用便宜/快速的模型。
OPENAI_MODEL=deepseek-v4-flash

# 学习阶段建议先用 mock。
# mock：不请求真实 API，不消耗额度，适合先理解代码逻辑。
# real：请求真实 API，需要可用的 OPENAI_API_KEY。
AI_CHAT_MODE=real

# 如果暂时没有 API key，可以把 AI_CHAT_MODE 改成 mock。

# 真实 embedding API 配置。
# 注意：DeepSeek 聊天 API 不一定提供 embedding endpoint。
# 如果你使用阿里云百炼 DashScope，可以按下面这样配置。
EMBEDDING_API_KEY=your_embedding_api_key_here
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_ENCODING_FORMAT=float

# 如果你想写成阿里官方常见环境变量名，也可以使用：
# DASHSCOPE_API_KEY=your_dashscope_api_key_here

# MySQL 配置。
# 先在 MySQL 里执行 mysql_schema.sql，创建 ai_chat_starter 数据库和 documents 表。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=ai_chat_starter

# Faucet MCP（用于后续数据库 Agent，请使用只读角色的 API Key）。
FAUCET_MCP_URL=http://localhost:8080/mcp
FAUCET_API_KEY=faucet_your_read_only_key_here

# 数据库 Agent 最多允许模型执行几轮工具调用。
AGENT_MAX_STEPS=6

# Streamlit 数据库 Agent 页面调用的 FastAPI 地址。
AGENT_API_BASE_URL=http://127.0.0.1:8000
